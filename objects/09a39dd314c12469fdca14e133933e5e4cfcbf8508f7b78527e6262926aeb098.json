{"id":"c1c4b08f-9ebe-49a9-89bc-8700987c9d54","doi":"10.3724/sp.j.1042.2026.2274","pmid":null,"openalexId":null,"title":"社会经济地位与公正世界信念的关系：一项三水平元分析","titleZh":null,"abstract":"公正世界信念具有维护个体心理健康与社会秩序的重要功能。以往研究考察了社会经济地位如何影响个体公正世界信念, 但结论不尽一致。对58项研究(纳入106, 585名被试, 113个效应量)进行三水平元分析, 结果表明, 社会经济地位与公正世界信念之间存在较小但显著的正向关系(r = 0.12, p < 0.001), 且该关联受国家不平等程度(Gini系数)、社会经济地位类型(主观vs.客观)和公正世界信念维度(个人vs.一般)调节。研究结果澄清了社会经济地位影响公正世界信念的方向与强度, 并凸显了宏观经济结构、个体地位认知和信念维度对公正相关信念的影响。","summaryZh":null,"authors":["吴晶莹","贾婷瑞","汪雅梦","吕飒飒","汪祚军","王礼军","Kai Qin Chan"],"rankingStatus":"unmatched","materialLevel":"abstract","publishedAt":null,"publicationDatePrecision":"day","discoveredAt":"2026-11-06T04:30:46.870Z","relevance":"psychology","topics":["clinical","cognitive","social","methods"],"retracted":false,"isUpdateNotice":false,"workType":null,"isResearchEvidence":true,"evidenceExclusionReason":null,"baseline":false,"fulltextLicense":null,"analysis":null,"revision":1,"analysisRevision":null,"url":"https://doi.org/10.3724/sp.j.1042.2026.2274","fulltextUrl":null,"fulltext":null,"teamKeys":[],"rankingCandidates":[],"journal":{"name":"心理科学进展","issns":["1671-3710"],"division":null,"rankingYear":null,"id":null},"sources":[{"source":"official-toc","fetchedAt":"2026-11-12T05:00:40.638183+00:00","sourceId":"","url":"https://journal.psych.ac.cn/xlkxjz/CN/10.3724/SP.J.1042.2026.2274"}],"publicationUpdates":[]}