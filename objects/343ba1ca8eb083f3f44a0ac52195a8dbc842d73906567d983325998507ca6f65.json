{"id":"1a1e9c26-e34a-48e0-b259-87778ced4e6f","doi":"10.3724/sp.j.1042.2026.2295","pmid":null,"openalexId":null,"title":"词汇快速映射学习的认知神经机制","titleZh":null,"abstract":"词汇的快速映射学习是指通过排除已知词汇, 快速建立新词与指称对象联结的学习方式。这种学习可以不需要长期的记忆巩固而快速建立新词与客体联结的皮层记忆, 而且学习效应持续得更久, 从而受到了研究者的广泛关注。文中系统梳理与总结了词汇快速映射学习的优势、认知机制以及神经基础的最新进展, 深入分析了快速映射学习的独特性、不同类型词汇学习的差异性、对传统学习理论的挑战三个方面的争论问题, 尤其是对快速映射学习与当前学习理论的关系进行探讨, 尝试以系统重组的视角解释快速映射学习, 并指明了词汇快速映射学习乃至学习与记忆理论研究的新方向。","summaryZh":null,"authors":["王艺璇","杨剑峰"],"rankingStatus":"unmatched","materialLevel":"abstract","publishedAt":null,"publicationDatePrecision":"day","discoveredAt":"2026-11-06T04:30:46.871Z","relevance":"psychology","topics":["cognitive","neuroscience"],"retracted":false,"isUpdateNotice":false,"workType":null,"isResearchEvidence":true,"evidenceExclusionReason":null,"baseline":false,"fulltextLicense":null,"analysis":null,"revision":1,"analysisRevision":null,"url":"https://doi.org/10.3724/sp.j.1042.2026.2295","fulltextUrl":null,"fulltext":null,"teamKeys":[],"rankingCandidates":[],"journal":{"name":"心理科学进展","issns":["1671-3710"],"division":null,"rankingYear":null,"id":null},"sources":[{"source":"official-toc","fetchedAt":"2026-11-12T05:00:40.638648+00:00","sourceId":"","url":"https://journal.psych.ac.cn/xlkxjz/CN/10.3724/SP.J.1042.2026.2295"}],"publicationUpdates":[]}